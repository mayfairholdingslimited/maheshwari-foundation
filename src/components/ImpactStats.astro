---
import { impactStats } from "../data/site";
---

<section id="impact" class="bg-ink-50 py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mb-14 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">
        Our impact
      </p>
      <h2 class="display mt-4 text-4xl leading-tight text-ink-900 sm:text-5xl">
        The numbers behind the work.
      </h2>
    </div>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-4">
      {impactStats.map((s) => (
        <div class="reveal border-t border-ink-200 pt-6">
          <dt class="display text-5xl text-brand-600 sm:text-6xl">{s.value}</dt>
          <dd class="mt-3 text-sm leading-snug text-ink-600">{s.label}</dd>
        </div>
      ))}
    </dl>
    <p class="reveal mt-12 max-w-2xl text-sm text-ink-500">
      Figures reflect cumulative reach since 2020. Programmes continue to
      run year-round; full annual reporting is filed with the Charity Commission.
    </p>
  </div>
</section>
