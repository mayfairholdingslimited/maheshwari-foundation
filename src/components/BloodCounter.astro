---
import { DEFAULT_COUNTER, COUNTER_FIELDS } from "../data/counters";

// Seed values render server-side (the page stays static); a client script
// then fetches the live numbers from /api/counter and counts them up.
const c = DEFAULT_COUNTER;
---

<section id="blood-counter" class="bg-ink-900 py-24 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mb-14 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-300">
          Blood programme
        </p>
        <h2 class="display mt-4 text-4xl leading-tight text-white sm:text-5xl">
          Saving lives, counted.
        </h2>
      </div>
      <p class="text-sm text-ink-300">
        As on <span data-counter-ason class="font-semibold text-white">{c.asOn}</span>
      </p>
    </div>

    <dl class="grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-4">
      {COUNTER_FIELDS.map((f) => (
        <div class="reveal border-t border-ink-700 pt-6">
          <dt
            class="display text-5xl text-brand-300 sm:text-6xl"
            data-counter-key={f.key}
            data-counter-target={String(c[f.key])}
          >
            {c[f.key].toLocaleString()}
          </dt>
          <dd class="mt-3 text-sm leading-snug text-ink-300">{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>

  <script is:inline>
    (function () {
      const section = document.getElementById("blood-counter");
      if (!section) return;

      function animate(el, to) {
        const from = Number(el.getAttribute("data-counter-target")) || 0;
        if (from === to) {
          el.textContent = to.toLocaleString();
          return;
        }
        const duration = 1200;
        const start = performance.now();
        function tick(now) {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(from + (to - from) * eased).toLocaleString();
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      fetch("/api/counter", { headers: { accept: "application/json" } })
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          if (!data) return;
          const ason = section.querySelector("[data-counter-ason]");
          if (ason && data.asOn) ason.textContent = data.asOn;
          section.querySelectorAll("[data-counter-key]").forEach((el) => {
            const key = el.getAttribute("data-counter-key");
            if (typeof data[key] === "number") animate(el, data[key]);
          });
        })
        .catch(() => {});
    })();
  </script>
</section>
