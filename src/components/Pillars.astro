---
import { pillarMeta } from "../data/site";
import { projectsByPillar, type Pillar } from "../data/projects";

const order: Pillar[] = ["health", "education", "relief", "partnerships"];
---

<section class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mb-16 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">
          What we do
        </p>
        <h2 class="display mt-4 text-4xl leading-tight text-ink-900 sm:text-5xl">
          Four areas. One philosophy: stay close, stay long.
        </h2>
      </div>
      <p class="max-w-md text-base leading-relaxed text-ink-600">
        Most of our programmes are multi-year commitments — many running for
        more than a decade. We believe sustained presence does more good than
        one-off gestures.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {order.map((id) => {
        const p = pillarMeta[id];
        const count = projectsByPillar[id].length;
        return (
          <article class="reveal group relative overflow-hidden rounded-2xl bg-ink-50 shadow-sm transition hover:shadow-xl">
            <a href={`/our-work#${id}`} class="block">
              <div class="relative h-64 w-full overflow-hidden">
                <img
                  src={p.image}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent"></div>
                <div class="absolute bottom-5 left-6 right-6 flex items-end justify-between gap-4">
                  <h3 class="display text-2xl text-white sm:text-3xl">{p.title}</h3>
                  <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
                    {count} {count === 1 ? "programme" : "programmes"}
                  </span>
                </div>
              </div>
              <div class="p-8">
                <p class="text-base leading-relaxed text-ink-700">{p.blurb}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
                  See programmes <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>
