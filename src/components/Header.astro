---
import { site } from "../data/site";

const nav = [
  { href: "#mission", label: "Our work" },
  { href: "#impact", label: "Impact" },
  { href: "#reach", label: "Where we work" },
  { href: "#contact", label: "Contact" },
];
---

<header class="absolute inset-x-0 top-0 z-30">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <a href="/" class="flex items-center gap-3 text-white">
      <img
        src="/logo.png"
        alt={`${site.name} logo`}
        width="44"
        height="44"
        class="h-11 w-11 rounded-md bg-white/95 p-1 shadow-sm"
      />
      <span class="display text-lg font-semibold tracking-tight">
        {site.name}
      </span>
    </a>
    <nav class="hidden gap-8 text-sm font-medium text-white/90 md:flex">
      {nav.map((n) => (
        <a href={n.href} class="transition hover:text-white">{n.label}</a>
      ))}
    </nav>
    <a
      href="#contact"
      class="hidden rounded-full bg-white px-5 py-2 text-sm font-semibold text-brand-700 shadow-sm transition hover:bg-brand-50 md:inline-block"
    >
      Get involved
    </a>
  </div>
</header>
