---
import { foundation } from "../data/foundation";

// Hero rotation spans every country we work in, not just India.
// India banners supplied by Angana, May 2026 (2400 × 1350); the other
// countries are drawn from project photography (16:9, /banners/hero-*).
const slides = [
  {
    src: "/banners/banner-1.jpg",
    alt: "Boys from Bal Ashram in India team cricket kits — India",
  },
  {
    src: "/banners/hero-uae.jpg",
    alt: "Ramadan food distribution in Dubai labour camps — UAE",
  },
  {
    src: "/banners/banner-3.jpg",
    alt: "Children at Maheshwari School For All — India",
  },
  {
    src: "/banners/hero-uganda.jpg",
    alt: "Reading with schoolchildren in Bwindi — Uganda",
  },
  {
    src: "/banners/hero-philippines.jpg",
    alt: "Taal volcano eruption relief distribution — Philippines",
  },
  {
    src: "/banners/hero-thailand.jpg",
    alt: "Queen Savang Vadhana Memorial Hospital, Chon Buri — Thailand",
  },
  {
    src: "/banners/banner-2.jpg",
    alt: "A young student at the blackboard — India",
  },
];
---

<section class="relative isolate h-[92vh] min-h-[640px] w-full overflow-hidden bg-ink-900 text-white">
  <div class="absolute inset-0">
    {slides.map((s, i) => (
      <img
        src={s.src}
        alt={s.alt}
        data-slide={i}
        class:list={[
          "fade-slide ken-burns absolute inset-0 h-full w-full object-cover",
          i === 0 ? "is-active" : "",
        ]}
        loading={i === 0 ? "eager" : "lazy"}
        fetchpriority={i === 0 ? "high" : "auto"}
      />
    ))}
    <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/30 to-black/80"></div>
  </div>

  <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col justify-end px-6 pb-20 lg:px-10 lg:pb-28">
    <h1 class="reveal display max-w-4xl text-5xl leading-[1.05] text-brand-400 sm:text-6xl lg:text-7xl">
      {foundation.motto.split(".").map((part, i) => (
        <Fragment>
          <span>{part.trim()}{part.trim() && "."}</span>
          {i === 0 && <br />}
        </Fragment>
      ))}
    </h1>
    <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
      Since 2010 we have worked across India, the UAE, the Philippines, Uganda
      and Thailand — addressing illiteracy, hunger and deprivation through
      programmes that empower the people who need them most.
    </p>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <a
        href="/our-work"
        class="rounded-full bg-brand-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-900/30 transition hover:bg-brand-600"
      >
        See our work
      </a>
      <a
        href="/about"
        class="rounded-full border border-white/30 bg-white/5 px-7 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/15"
      >
        About the Foundation
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      const slides = document.querySelectorAll("[data-slide]");
      if (slides.length < 2) return;
      let i = 0;
      setInterval(() => {
        slides[i].classList.remove("is-active");
        i = (i + 1) % slides.length;
        slides[i].classList.add("is-active");
      }, 6000);
    })();
  </script>
</section>
