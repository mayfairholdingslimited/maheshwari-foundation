---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer id="contact" class="bg-ink-900 text-ink-100">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/logo.png"
            alt={`${site.name} logo`}
            class="h-12 w-12 rounded-md bg-white p-1"
          />
          <span class="display text-xl font-semibold text-white">{site.name}</span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ink-300">
          A UK-registered charity working quietly across continents — supporting
          health, education and community relief wherever the need is real.
        </p>
      </div>
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-ink-400">
          Get in touch
        </h4>
        <a
          href={`mailto:${site.email}`}
          class="mt-4 block text-lg text-white underline-offset-4 hover:underline"
        >
          {site.email}
        </a>
        <p class="mt-2 text-sm text-ink-300">
          Charity Registered Number <span class="text-white">{site.charityNumber}</span>
        </p>
      </div>
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-ink-400">
          Follow our work
        </h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href={site.social.instagram} target="_blank" rel="noopener noreferrer"
               class="text-white hover:text-brand-300 transition">Instagram</a>
          </li>
          <li>
            <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer"
               class="text-white hover:text-brand-300 transition">LinkedIn</a>
          </li>
          <li>
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer"
               class="text-white hover:text-brand-300 transition">Facebook</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-ink-700 pt-8 text-xs text-ink-400 md:flex-row md:items-center">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Charity Registered Number {site.charityNumber}</p>
    </div>
  </div>
</footer>
