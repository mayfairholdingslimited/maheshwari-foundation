---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { gratitude } from "../data/foundation";
---

<BaseLayout title="Gratitude — Maheshwari Foundation">
  <PageHero
    eyebrow="With thanks"
    title="Gratitude."
    subtitle={gratitude.intro}
  />

  <section class="bg-white py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <h2 class="reveal display text-2xl text-ink-900 sm:text-3xl">Individuals</h2>
      <ul class="reveal mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {gratitude.individuals.map((name) => (
          <li class="border-l-2 border-brand-200 pl-4 py-1 text-lg text-ink-800">
            {name}
          </li>
        ))}
      </ul>

      <h2 class="reveal display mt-16 text-2xl text-ink-900 sm:text-3xl">
        Organisations
      </h2>
      <ul class="reveal mt-8 grid gap-3 sm:grid-cols-2">
        {gratitude.organisations.map((org) => (
          <li class="border-l-2 border-brand-200 pl-4 py-1 text-lg text-ink-800">
            {org}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
