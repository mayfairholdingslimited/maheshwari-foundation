---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { partners } from "../data/partners";
---

<BaseLayout title="Other Charities — Maheshwari Foundation">
  <PageHero
    eyebrow="In good company"
    title="Other charities we believe in."
    subtitle="Causes and organisations we have supported, or whose work we want to amplify."
  />

  <section class="bg-white py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {partners.map((p) => (
          <a
            href={p.website}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal group block overflow-hidden rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow-xl"
          >
            <div class="flex h-24 w-full items-center justify-center bg-ink-50 rounded-xl overflow-hidden">
              <img
                src={p.logo}
                alt={`${p.name} logo`}
                loading="lazy"
                class="max-h-20 max-w-[80%] object-contain"
              />
            </div>
            <h3 class="display mt-6 text-xl text-ink-900">{p.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{p.description}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
              Visit site <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
