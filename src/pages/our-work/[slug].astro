---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, projectsByPillar, type Project } from "../../data/projects";
import { pillarMeta } from "../../data/site";

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const meta = pillarMeta[project.pillar];

// Two-up: other programmes in the same pillar, max 3.
const related = projectsByPillar[project.pillar]
  .filter((p) => p.slug !== project.slug)
  .slice(0, 3);
---

<BaseLayout title={`${project.title} — Maheshwari Foundation`}>
  <article>
    <section class="relative isolate h-[60vh] min-h-[440px] w-full overflow-hidden bg-ink-900 text-white">
      <img
        src={project.image}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-70"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/80"></div>
      <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col justify-end px-6 pb-16 lg:px-10 lg:pb-20">
        <p class="reveal mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-300">
          <span class="h-px w-8 bg-brand-300"></span>
          {meta.title}
        </p>
        <h1 class="reveal display max-w-4xl text-4xl leading-[1.1] text-white sm:text-5xl lg:text-6xl">
          {project.title}
        </h1>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-12 lg:px-10">
        <aside class="reveal space-y-6 lg:col-span-4">
          {project.date && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">When</p>
              <p class="mt-2 text-base text-ink-800">{project.date}</p>
            </div>
          )}
          {project.location && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">Where</p>
              <p class="mt-2 text-base text-ink-800">{project.location}</p>
            </div>
          )}
          {project.beneficiaries && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">Reach</p>
              <p class="mt-2 text-base text-ink-800">{project.beneficiaries}</p>
            </div>
          )}
          {project.partners && project.partners.length > 0 && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">Partners</p>
              <ul class="mt-2 space-y-1 text-base text-ink-800">
                {project.partners.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          )}
        </aside>
        <div class="reveal space-y-6 text-lg leading-relaxed text-ink-700 lg:col-span-8">
          {project.body && project.body.length > 0 ? (
            project.body.map((para) => <p>{para}</p>)
          ) : (
            <p>{project.description}</p>
          )}
          <a
            href="/our-work"
            class="inline-flex items-center gap-2 pt-4 text-sm font-semibold text-brand-700 transition hover:text-brand-800"
          >
            <span aria-hidden="true">←</span> Back to all programmes
          </a>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="bg-ink-50 py-16 lg:py-20">
        <div class="mx-auto max-w-7xl px-6 lg:px-10">
          <h2 class="display mb-10 text-2xl text-ink-900 sm:text-3xl">
            More in {meta.title}
          </h2>
          <div class="grid gap-8 md:grid-cols-3">
            {related.map((r) => (
              <a href={`/our-work/${r.slug}`} class="group block overflow-hidden rounded-2xl bg-white shadow-sm transition hover:shadow-xl">
                <div class="relative h-44 w-full overflow-hidden">
                  <img
                    src={r.image}
                    alt=""
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-[1000ms] ease-out group-hover:scale-105"
                  />
                </div>
                <div class="p-5">
                  <h3 class="display text-lg text-ink-900">{r.title}</h3>
                  {r.location && (
                    <p class="mt-1 text-xs uppercase tracking-wider text-ink-500">
                      {r.location}
                    </p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
