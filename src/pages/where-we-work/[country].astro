---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { locations } from "../../data/site";
import { projectsByCountry } from "../../data/projects";
import { partners } from "../../data/partners";

export function getStaticPaths() {
  return locations.map((l) => ({
    params: { country: l.country.toLowerCase().replace(/\s+/g, "-") },
    props: { country: l.country, places: l.places },
  }));
}

interface Props {
  country: string;
  places: string;
}
const { country, places } = Astro.props;
const items = projectsByCountry(country);
const countryPartners = partners.filter((p) => p.country === country);
---

<BaseLayout title={`${country} — Maheshwari Foundation`}>
  <PageHero
    eyebrow="Where we work"
    title={`Our work in ${country}.`}
    subtitle={places}
  />

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <a
        href="/#reach"
        class="reveal mb-12 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 transition hover:text-brand-800"
      >
        <span aria-hidden="true">←</span> All countries
      </a>

      {items.length > 0 && (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {items.map((p) => (
            <a
              href={`/our-work/${p.slug}`}
              class="reveal group block overflow-hidden rounded-2xl bg-ink-50 shadow-sm transition hover:shadow-xl"
            >
              <div class="relative h-48 w-full overflow-hidden">
                <img
                  src={p.image}
        style={p.imagePosition ? `object-position: ${p.imagePosition}` : undefined}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-[1000ms] ease-out group-hover:scale-105"
                />
              </div>
              <div class="p-6">
                <h3 class="display text-xl leading-snug text-ink-900">{p.title}</h3>
                {p.location && (
                  <p class="mt-2 text-xs uppercase tracking-wider text-ink-500">
                    {p.location}
                  </p>
                )}
                <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-ink-600">
                  {p.description}
                </p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
                  Read more <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      )}

      {countryPartners.length > 0 && (
        <div class={items.length > 0 ? "mt-20" : ""}>
          <h2 class="reveal display mb-8 text-3xl text-ink-900">
            Charities we support in {country}
          </h2>
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {countryPartners.map((p) => (
              <a
                href={p.website}
                target="_blank"
                rel="noopener noreferrer"
                class="reveal group block overflow-hidden rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow-xl"
              >
                <div class="flex h-24 w-full items-center justify-center">
                  <img
                    src={p.logo}
                    alt={`${p.name} logo`}
                    loading="lazy"
                    class="max-h-20 max-w-[80%] object-contain mix-blend-multiply"
                  />
                </div>
                <h3 class="display mt-6 text-xl text-ink-900">{p.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-600">{p.description}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
                  Visit site <span aria-hidden="true">↗</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      {items.length === 0 && countryPartners.length === 0 && (
        <div class="reveal rounded-2xl bg-ink-50 p-12 text-center">
          <p class="text-lg text-ink-700">
            More from our work in {country} is coming to the site soon.
          </p>
          <a
            href="/our-work"
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 transition hover:text-brand-800"
          >
            See all programmes <span aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
