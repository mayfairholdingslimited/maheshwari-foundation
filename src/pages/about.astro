---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { foundation } from "../data/foundation";
import { locations } from "../data/site";

const focusBlurbs: Record<string, string> = {
  Health:
    "Blood banks, thalassemia care, inclusion for differently abled, and oxygen provision.",
  Hunger:
    "Food drives, daily meals at school, sustained nutrition for those who feed cities.",
  Literacy:
    "Early education, scholarships, university support, and the long-term mentoring that makes a long-lasting effect.",
};
---

<BaseLayout title={`About — ${foundation.motto}`}>
  <PageHero
    eyebrow="About the Foundation"
    title="Who we are. Why we do this."
    subtitle="A family-led charity working across continents — quietly, and for the long term."
  />

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-12 lg:px-10">
      <div class="reveal lg:col-span-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">
          Our story
        </p>
        <h2 class="display mt-4 text-3xl leading-tight text-ink-900 sm:text-4xl">
          Founded in India in 2010. Registered in the UK in 2011.
        </h2>
      </div>
      <div class="reveal space-y-6 text-lg leading-relaxed text-ink-700 lg:col-span-8">
        <p>{foundation.longDescription}</p>
        <p>
          We work on the principle that <em>{foundation.principle.toLowerCase().replace(/\.$/, '')}</em>.
          Our vision is to equip people with the tools to discover the inner
          strength and confidence to find their place in society.
        </p>
        <p>
          To date, we have committed a minimum of <strong>INR 10 crore</strong>
          toward our objectives.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ink-50 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">
        Focus areas
      </p>
      <h2 class="reveal display mt-4 max-w-3xl text-3xl leading-tight text-ink-900 sm:text-4xl">
        Three words have guided our work for fifteen years.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {foundation.focusAreas.map((f, i) => (
          <div class="reveal group cursor-default rounded-2xl bg-white p-8 shadow-sm transition duration-300 hover:bg-brand-500 hover:shadow-lg hover:shadow-brand-900/10">
            <p class="font-mono text-xs text-brand-500 transition group-hover:text-white/80">
              0{i + 1}
            </p>
            <h3 class="display mt-3 text-3xl text-ink-900 transition group-hover:text-white">{f}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-600 transition group-hover:text-white/90">
              {focusBlurbs[f]}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-500 py-20 text-white lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="reveal max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">
          Motto
        </p>
        <p class="display mt-6 text-4xl leading-tight sm:text-5xl lg:text-6xl">
          "{foundation.motto}"
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-20 text-white lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-brand-300">
        Where we work
      </p>
      <h2 class="reveal display mt-4 max-w-2xl text-3xl leading-tight text-white sm:text-4xl">
        Five countries. One belief: care has no borders.
      </h2>
      <ol class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-ink-700 sm:grid-cols-2 lg:grid-cols-5">
        {locations.map((l, i) => (
          <li class="reveal group bg-ink-900 p-8 transition duration-300 hover:bg-brand-600">
            <p class="text-xs font-mono text-brand-300 transition group-hover:text-white/80">
              0{i + 1}
            </p>
            <h3 class="display mt-3 text-2xl text-white">{l.country}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-300 transition group-hover:text-white/90">
              {l.places}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
