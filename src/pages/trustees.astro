---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { trustees } from "../data/trustees";
---

<BaseLayout title="Trustees — Maheshwari Foundation">
  <PageHero
    eyebrow="The people behind the work"
    title="Our trustees."
    subtitle="A family — and a small group of friends — who have stewarded this work for over a decade."
  />

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
        {trustees.map((t) => (
          <article class:list={[
            "reveal",
            t.inMemoriam && "rounded-2xl bg-ink-50 p-6 sm:col-span-2 lg:col-span-3",
          ]}>
            <div class:list={[
              t.inMemoriam ? "flex flex-col gap-8 md:flex-row md:items-start" : "",
            ]}>
              <img
                src={t.photo}
                alt={`${t.name} portrait`}
                loading="lazy"
                class:list={[
                  "rounded-2xl bg-ink-100 object-cover",
                  t.inMemoriam
                    ? "h-72 w-full flex-none md:h-72 md:w-56"
                    : "aspect-[3/4] w-full",
                ]}
              />
              <div class={t.inMemoriam ? "" : "mt-6"}>
                <h3 class="display text-2xl text-ink-900">{t.name}</h3>
                <p class:list={[
                  "mt-1 text-sm font-medium",
                  t.inMemoriam ? "text-brand-700" : "text-brand-600",
                ]}>
                  {t.role}
                </p>
                <p class="mt-4 text-base leading-relaxed text-ink-700">
                  {t.bio}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
