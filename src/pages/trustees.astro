---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { trustees } from "../data/trustees";
---

<BaseLayout title="Trustees — Maheshwari Foundation">
  <PageHero
    eyebrow="The people behind the work"
    title="Our trustees."
    subtitle="A family — and a small group of friends — who have stewarded this work for over a decade."
  />

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-6xl px-6 lg:px-10">
      <div class="grid gap-x-12 gap-y-16 md:grid-cols-2">
        {trustees.map((t) => (
          <article class="reveal">
            <img
              src={t.photo}
              alt={`${t.name} portrait`}
              loading="lazy"
              class="aspect-[4/5] w-full rounded-2xl bg-ink-100 object-cover"
            />
            <div class="mt-6">
              <h3 class="display text-2xl text-ink-900">
                {t.linkedin ? (
                  <a
                    href={t.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition hover:text-brand-700"
                  >
                    {t.name}
                  </a>
                ) : (
                  t.name
                )}
              </h3>
              <p class:list={[
                "mt-1 text-sm font-medium",
                t.inMemoriam ? "text-brand-700" : "text-brand-600",
              ]}>
                {t.role}
              </p>
              <p class="mt-4 text-base leading-relaxed text-ink-700">
                {t.bio}
              </p>
              {t.linkedin && (
                <a
                  href={t.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.name} on LinkedIn`}
                  class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 transition hover:text-brand-800"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
                  </svg>
                  Connect on LinkedIn
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
