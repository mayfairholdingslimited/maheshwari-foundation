---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { trustees } from "../data/trustees";
---

<BaseLayout title="Trustees — Maheshwari Foundation">
  <PageHero
    eyebrow="The people behind the work"
    title="Our trustees."
    subtitle="A family — and a small group of friends — who have stewarded this work for over a decade."
  />

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-6xl px-6 lg:px-10">
      <div class="grid gap-x-12 gap-y-16 md:grid-cols-2">
        {trustees.map((t) => (
          <article class="reveal">
            <img
              src={t.photo}
              alt={`${t.name} portrait`}
              loading="lazy"
              class="aspect-[4/5] w-full rounded-2xl bg-ink-100 object-cover"
            />
            <div class="mt-6">
              <h3 class="display text-2xl text-ink-900">{t.name}</h3>
              <p class:list={[
                "mt-1 text-sm font-medium",
                t.inMemoriam ? "text-brand-700" : "text-brand-600",
              ]}>
                {t.role}
              </p>
              <p class="mt-4 text-base leading-relaxed text-ink-700">
                {t.bio}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
